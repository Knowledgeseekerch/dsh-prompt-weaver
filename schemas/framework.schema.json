{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsh-prompt-weaver/framework.schema.json",
  "title": "DSH Prompt Weaver Framework",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "taskTypes", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": 120 },
        "en": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": 500 },
        "en": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "taskTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "guidance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "title": { "$ref": "#/properties/name" },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "zh": { "type": "string", "minLength": 1, "maxLength": 1200 },
              "en": { "type": "string", "minLength": 1, "maxLength": 1200 }
            }
          },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
